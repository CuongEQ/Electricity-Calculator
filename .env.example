# Firebase Environment Variables (Cấu hình trên Vercel Project Settings > Environment Variables)
# Không bao giờ commit file .env chứa giá trị thật lên GitHub!

FIREBASE_API_KEY=AIzaSyYourApiKeyHere
FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-app-id
FIREBASE_STORAGE_BUCKET=your-app-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456
